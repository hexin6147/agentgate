# Copy to .env and fill in. Never commit .env.

# Local model (Ollama, OpenAI-compatible)
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen2.5:7b-instruct
LLM_API_KEY=ollama
LLM_TIMEOUT=120

# Judge (ideally a different model family from the agent)
JUDGE_BASE_URL=http://127.0.0.1:11434/v1
JUDGE_MODEL=qwen2.5:7b-instruct
JUDGE_API_KEY=ollama

# DeepSeek (OpenAI-compatible)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Feishu self-built app
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Runtime
AGENTGATE_MODE=mock
AGENTGATE_AGENT=rule
AGENTGATE_CONTEXT=rule
AGENTGATE_TRACE_DIR=eval/results

# Local BGE embeddings (Ollama)
EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_MODEL=quentinz/bge-base-zh-v1.5:latest
AGENTGATE_PROJECT_ID=demo
# Set to true to let request_review pass F1 and surface the confirmation card.
AGENTGATE_INCIDENT_LEVELED=false
